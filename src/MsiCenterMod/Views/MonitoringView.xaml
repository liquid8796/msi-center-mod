<UserControl x:Class="MsiCenterMod.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MsiCenterMod.Controls">

    <UserControl.Resources>
        <Style x:Key="MetricHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="38" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowSep" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource Brush.Border}" />
        </Style>
        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,22">
        <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="11*" />
                <ColumnDefinition Width="9*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Cột trái: donut + disk/memory ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,30,0">
                <UniformGrid Columns="2">
                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricHeader}" Text="CPU Usage" />
                        <Grid Width="175" Height="175" Margin="0,20,0,0" HorizontalAlignment="Left">
                            <controls:DonutGauge Value="{Binding Monitoring.CpuUsage}"
                                                 RingThickness="14"
                                                 TrackBrush="{StaticResource Brush.Card}"
                                                 FillBrush="{StaticResource Brush.Accent}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BigNumber}" HorizontalAlignment="Center"
                                           Text="{Binding Monitoring.CpuUsageText}" />
                                <TextBlock FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" Text="%" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricHeader}" Text="GPU Usage" />
                        <Grid Width="175" Height="175" Margin="0,20,0,0" HorizontalAlignment="Left">
                            <controls:DonutGauge Value="{Binding Monitoring.GpuUsage}"
                                                 RingThickness="14"
                                                 TrackBrush="{StaticResource Brush.Card}"
                                                 FillBrush="{StaticResource Brush.Accent}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource BigNumber}" HorizontalAlignment="Center"
                                           Text="{Binding Monitoring.GpuUsageText}" />
                                <TextBlock FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextDim}" Text="%" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </UniformGrid>

                <UniformGrid Columns="2" Margin="0,38,0,0">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource MetricHeader}" Text="Disk" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Monitoring.DiskActivity}" />
                            <TextBlock FontSize="14" Margin="4,0,0,8" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource Brush.TextDim}" Text="%" />
                        </StackPanel>
                        <ProgressBar Style="{StaticResource Bar.Thin}" Margin="0,8,0,0"
                                     Background="{StaticResource Brush.Card}"
                                     Value="{Binding Monitoring.DiskActivity, Mode=OneWay}" />
                        <Button Style="{StaticResource Button.Ghost}" Margin="0,14,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding Monitoring.CleanDiskCommand}"
                                Content="{DynamicResource S.Mon.CleanDisk}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource MetricHeader}" Text="Memory" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource BigNumber}" Text="{Binding Monitoring.MemoryUsage}" />
                            <TextBlock FontSize="14" Margin="4,0,0,8" VerticalAlignment="Bottom"
                                       Foreground="{StaticResource Brush.TextDim}" Text="%" />
                        </StackPanel>
                        <ProgressBar Style="{StaticResource Bar.Thin}" Margin="0,8,0,0"
                                     Background="{StaticResource Brush.Card}"
                                     Value="{Binding Monitoring.MemoryUsage, Mode=OneWay}" />
                    </StackPanel>
                </UniformGrid>
            </StackPanel>

            <!-- ===== Cột phải: bảng thông tin ===== -->
            <StackPanel Grid.Column="1">
                <!-- GPU -->
                <Border Style="{StaticResource InfoCard}">
                    <StackPanel>
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="GPU Name" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Margin="12,0,0,0"
                                       Text="{Binding Monitoring.GpuName}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="GPU Clock" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.GpuClockText}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="VRAM Clock" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.VramClockText}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="GPU Temperature" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.GpuTempText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CPU -->
                <Border Style="{StaticResource InfoCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="CPU Name" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Margin="12,0,0,0"
                                       Text="{Binding Monitoring.CpuName}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="CPU Temperature" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.CpuTempText}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hệ thống -->
                <Border Style="{StaticResource InfoCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="RAM" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.RamText}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="SSD" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}" Margin="12,0,10,0"
                                       Text="{Binding Monitoring.SsdAvailableText}" />
                            <ProgressBar Grid.Column="2" Style="{StaticResource Bar.Thin}" Width="70"
                                         VerticalAlignment="Center"
                                         Background="{StaticResource Brush.Border}"
                                         Value="{Binding Monitoring.SsdUsedPercent, Mode=OneWay}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource RowValue}" Margin="10,0,0,0"
                                       Text="{Binding Monitoring.SsdUsedPercent, StringFormat={}{0} %}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Fan 1 (CPU)" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.Fan1Text}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="Fan 2 (GPU)" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.Fan2Text}" />
                        </Grid>
                        <Border Style="{StaticResource RowSep}" />
                        <Grid Height="46">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowLabel}" Text="LAN" />
                            <TextBlock Grid.Column="1" Style="{StaticResource RowValue}"
                                       Text="{Binding Monitoring.LanText}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
