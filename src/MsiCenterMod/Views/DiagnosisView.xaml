<UserControl x:Class="MsiCenterMod.Views.DiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MsiCenterMod.Controls"
             xmlns:models="clr-namespace:MsiCenterMod.Models"
             xmlns:vm="clr-namespace:MsiCenterMod.ViewModels">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#141720" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,22">
        <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="11*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Battery Master ===== -->
            <StackPanel Grid.Column="0" Margin="0,0,26,0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Battery Master" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Text="{DynamicResource S.Diag.BatteryHint}" />

                        <RadioButton GroupName="Battery" Style="{StaticResource Radio.Row}"
                                     IsChecked="{Binding Diagnosis.BatteryMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:BatteryChargeMode.BestForMobility}}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="⚡ Best for Mobility" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                           Text="{DynamicResource S.Bat.Mobility.Sub}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Battery" Style="{StaticResource Radio.Row}"
                                     IsChecked="{Binding Diagnosis.BatteryMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:BatteryChargeMode.Balanced}}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="⚖️ Balanced" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                           Text="{DynamicResource S.Bat.Balanced.Sub}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Battery" Style="{StaticResource Radio.Row}"
                                     IsChecked="{Binding Diagnosis.BatteryMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:BatteryChargeMode.BestForBattery}}">
                            <StackPanel>
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="🔋 Best for Battery" />
                                <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                           Text="{DynamicResource S.Bat.Battery.Sub}" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock FontSize="12" Margin="2,4,0,0"
                                   Foreground="{StaticResource Brush.TextDim}"
                                   Text="{Binding Diagnosis.BatteryStatusText}" />

                        <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14" />

                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Brush.AccentRed}"
                                   Text="Battery Calibration" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextDim}" TextWrapping="Wrap"
                                   Margin="0,4,0,10"
                                   Text="{DynamicResource S.Diag.CalibrationText}" />
                        <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left"
                                Content="{DynamicResource S.Diag.CalibrationRun}"
                                Command="{Binding Diagnosis.RunBatteryCalibrationCommand}"
                                Visibility="{Binding Diagnosis.IsBatteryCalibrationAvailable, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== System Checker + SSD Status ===== -->
            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource SectionTitle}" Text="System Checker" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource Brush.Text}" Text="Disk" />
                                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="{Binding Diagnosis.DiskActivity, StringFormat={}{0} %}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar.Thin}" Margin="0,8,0,16"
                                         Value="{Binding Diagnosis.DiskActivity, Mode=OneWay}" />
                            <Grid>
                                <TextBlock FontSize="13" Foreground="{StaticResource Brush.Text}" Text="Memory" />
                                <TextBlock HorizontalAlignment="Right" FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="{Binding Diagnosis.MemoryUsage, StringFormat={}{0} %}" />
                            </Grid>
                            <ProgressBar Style="{StaticResource Bar.Thin}" Margin="0,8,0,8"
                                         Value="{Binding Diagnosis.MemoryUsage, Mode=OneWay}" />
                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.Success}"
                                       Text="{Binding Diagnosis.FreeMemoryResult}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Ghost}" MinWidth="150" Margin="0,0,0,10"
                                    Content="{DynamicResource S.Diag.CleanDisk}"
                                    Command="{Binding Diagnosis.CleanDiskCommand}" />
                            <Button Style="{StaticResource Button.Ghost}" MinWidth="150"
                                    Content="{DynamicResource S.Diag.FreeMem}"
                                    Command="{Binding Diagnosis.FreeMemoryCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="0,22,0,12">
                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0" Text="SSD Status" />
                    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right" Padding="10,4"
                            Content="🔄" ToolTip="{DynamicResource S.Diag.RefreshTip}"
                            Command="{Binding Diagnosis.RefreshDisksCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Diagnosis.Disks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DiskCardViewModel}">
                            <Border Background="#141720" BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,10,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="92" Height="92">
                                            <controls:DonutGauge Value="{Binding UsedPercent}"
                                                                 RingThickness="9"
                                                                 TrackBrush="{StaticResource Brush.Card}"
                                                                 FillBrush="{StaticResource Brush.Accent}" />
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock FontSize="17" FontWeight="Bold" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Brush.Text}"
                                                           Text="{Binding UsedPercent, StringFormat={}{0}%}" />
                                                <TextBlock FontSize="9.5" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource Brush.TextDim}" Text="Used" />
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding TotalText}" />
                                            <TextBlock FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{StaticResource Brush.Text}"
                                                       Text="{Binding UsedText}" />
                                            <TextBlock FontSize="11.5" Margin="0,4,0,0"
                                                       Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding FreeText}" />
                                            <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"
                                                       Foreground="{StaticResource Brush.TextDim}"
                                                       Text="{Binding TemperatureText}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,10" />
                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Brush.Text}" Text="{Binding Model}" />
                                    <TextBlock FontSize="11.5" Margin="0,4,0,0" FontWeight="SemiBold"
                                               Text="{Binding HealthText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
