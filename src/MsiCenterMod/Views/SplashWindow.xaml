<Window x:Class="MsiCenterMod.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSI Center Mod"
        Width="460" Height="210"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">

    <!-- Margin chừa chỗ cho đổ bóng -->
    <Border Margin="18"
            Background="{StaticResource Brush.Sidebar}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" Direction="270" Opacity="0.55" ShadowDepth="5" Color="Black" />
        </Border.Effect>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Brush.Text}">
                <Run Text="MSI CENTER" /><Run Text=" MOD" Foreground="{StaticResource Brush.AccentRed}" />
            </TextBlock>

            <TextBlock Grid.Row="1" Margin="0,4,0,0" FontSize="12"
                       Foreground="{StaticResource Brush.TextDim}"
                       Text="{DynamicResource S.Tagline}" />

            <ProgressBar x:Name="Bar" Grid.Row="3"
                         Style="{StaticResource Bar.Thin}"
                         Height="6" Minimum="0" Maximum="100" Value="0" />

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Brush.TextDim}"
                           Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                           Foreground="{StaticResource Brush.TextDim}"
                           Text="{Binding VersionText}" />
            </Grid>
        </Grid>
    </Border>
</Window>
