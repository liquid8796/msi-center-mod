<Window x:Class="MsiCenterMod.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MsiCenterMod.Converters"
        xmlns:models="clr-namespace:MsiCenterMod.Models"
        xmlns:vm="clr-namespace:MsiCenterMod.ViewModels"
        xmlns:views="clr-namespace:MsiCenterMod.Views"
        Title="MSI Center Mod"
        Width="1180" Height="760"
        MinWidth="1000" MinHeight="660"
        Background="{StaticResource Brush.Background}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Style="{StaticResource Tab.Main}"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="🎛️  User Scenario">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="4,4,4,18">
                        <TextBlock FontSize="19" FontWeight="Bold" Foreground="{StaticResource Brush.Text}">
                            <Run Text="MSI CENTER" /><Run Text=" MOD" Foreground="{StaticResource Brush.AccentRed}" />
                        </TextBlock>
                        <TextBlock Margin="0,4,0,0" FontSize="12"
                                   Foreground="{StaticResource Brush.TextDim}"
                                   Text="User Scenario không giới hạn" />
                        <Rectangle Height="3" Margin="0,10,0,0" HorizontalAlignment="Left" Width="120"
                                   Fill="{StaticResource Brush.Accent}" RadiusX="1.5" RadiusY="1.5" />
                    </StackPanel>

                    <!-- Danh sách scenario -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Scenarios}"
                             SelectedItem="{Binding SelectedScenario}"
                             Style="{StaticResource List.Scenarios}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ScenarioViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontSize="22" Margin="2,0,10,0"
                                               VerticalAlignment="Center" Text="{Binding Glyph}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource Brush.TextDim}"
                                                   Text="{Binding Summary}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Thêm scenario -->
                    <Button Grid.Row="2" Margin="0,10,0,0"
                            Style="{StaticResource Button.Accent}"
                            Command="{Binding AddScenarioCommand}"
                            Content="＋  Thêm scenario mới" />

                    <TextBlock Grid.Row="3" Margin="4,12,4,0" FontSize="11"
                               Foreground="{StaticResource Brush.TextDim}"
                               Text="{Binding VersionText}" />
                </Grid>
            </Border>

            <!-- ================= EDITOR ================= -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,18,26,18">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

                    <!-- Cảnh báo phần cứng -->
                    <Border Background="#2A2115" BorderBrush="{StaticResource Brush.Warning}"
                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding ShowHardwareWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{StaticResource Brush.Warning}" FontSize="12.5" TextWrapping="Wrap">
                            <Run Text="⚠ " /><Run Text="{Binding HardwareWarningText, Mode=OneWay}" />
                        </TextBlock>
                    </Border>

                    <!-- Cảnh báo AI Cooling -->
                    <Border Background="#2A2115" BorderBrush="{StaticResource Brush.Warning}"
                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding ShowAiCoolingWarning, Converter={StaticResource BoolToVis}}">
                        <TextBlock Foreground="{StaticResource Brush.Warning}" FontSize="12.5" TextWrapping="Wrap"
                                   Text="⚠ MSI Center đang bật AI Cooling / Smart Auto — tính năng này sẽ tự ghi đè cấu hình quạt. Hãy tắt nó trong MSI Center (Features → User Scenario) để scenario của bạn không bị can thiệp." />
                    </Border>

                    <ContentControl Content="{Binding SelectedScenario}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:ScenarioViewModel}">
                                <StackPanel>

                                    <!-- Header: glyph + tên -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ComboBox Grid.Column="0" Width="64" Margin="0,0,10,0"
                                                  Style="{StaticResource Combo.Dark}"
                                                  FontSize="20"
                                                  SelectedValuePath="Content"
                                                  SelectedValue="{Binding Glyph}"
                                                  VerticalAlignment="Center">
                                            <ComboBoxItem Content="🎮" />
                                            <ComboBoxItem Content="💻" />
                                            <ComboBoxItem Content="🔋" />
                                            <ComboBoxItem Content="🎬" />
                                            <ComboBoxItem Content="🔥" />
                                            <ComboBoxItem Content="❄️" />
                                            <ComboBoxItem Content="🚀" />
                                            <ComboBoxItem Content="🌙" />
                                        </ComboBox>

                                        <TextBox Grid.Column="1" Style="{StaticResource TextBox.Dark}"
                                                 FontWeight="SemiBold"
                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=400}"
                                                 VerticalAlignment="Center" />

                                        <Button Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DuplicateScenarioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Content="⧉ Nhân bản" ToolTip="Tạo bản sao scenario này" />
                                        <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource Button.Ghost}"
                                                Command="{Binding DataContext.DeleteScenarioCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Content="🗑 Xóa" />
                                    </Grid>

                                    <!-- MỨC HIỆU NĂNG -->
                                    <TextBlock Style="{StaticResource Text.SectionHeader}" Text="MỨC HIỆU NĂNG" />
                                    <UniformGrid Columns="4">
                                        <RadioButton GroupName="Perf" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding Performance, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:PerformanceLevel.Turbo}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="⚡" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Turbo" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Hiệu năng tối đa" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Perf" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding Performance, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:PerformanceLevel.High}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="🚀" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Cao" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Chơi game nhẹ" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Perf" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding Performance, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:PerformanceLevel.Balanced}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="⚖️" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Cân bằng" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Dùng hằng ngày" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Perf" Style="{StaticResource Radio.Card}" Margin="0"
                                                     IsChecked="{Binding Performance, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:PerformanceLevel.Eco}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="🍃" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Tiết kiệm" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Kéo dài pin" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <!-- CHẾ ĐỘ QUẠT -->
                                    <TextBlock Style="{StaticResource Text.SectionHeader}" Text="CHẾ ĐỘ QUẠT" />
                                    <UniformGrid Columns="4">
                                        <RadioButton GroupName="Fan" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding FanMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:FanMode.Auto}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="🌀" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Tự động" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="EC tự điều khiển" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Fan" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding FanMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:FanMode.Silent}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="🤫" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Im lặng" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Ưu tiên êm ái" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Fan" Style="{StaticResource Radio.Card}"
                                                     IsChecked="{Binding FanMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:FanMode.Advanced}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="🎛️" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Tùy chỉnh" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Đường cong 6 điểm" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton GroupName="Fan" Style="{StaticResource Radio.Card}" Margin="0"
                                                     IsChecked="{Binding FanMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static models:FanMode.CoolerBoost}}">
                                            <StackPanel>
                                                <TextBlock FontSize="20" HorizontalAlignment="Center" Text="❄️" />
                                                <TextBlock FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" Text="Cooler Boost" />
                                                <TextBlock FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" Text="Quạt tối đa" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <!-- ĐƯỜNG CONG QUẠT -->
                                    <StackPanel Visibility="{Binding IsAdvancedFan, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Style="{StaticResource Text.SectionHeader}" Text="ĐƯỜNG CONG QUẠT (%) — 0–150, theo ngưỡng nhiệt của EC" />
                                        <UniformGrid Columns="2">
                                            <!-- CPU -->
                                            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,10,0">
                                                <StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Text}" Text="Quạt CPU" />
                                                    <ItemsControl ItemsSource="{Binding CpuPoints}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:FanPointViewModel}">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource Brush.Text}" Text="{Binding SpeedLabel}" />
                                                                    <Slider Height="130" Margin="0,6" Style="{StaticResource Slider.Fan}"
                                                                            Value="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock FontSize="10.5" HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource Brush.TextDim}" Text="{Binding TemperatureLabel}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <!-- GPU -->
                                            <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Border}"
                                                    BorderThickness="1" CornerRadius="10" Padding="14,10">
                                                <StackPanel>
                                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Brush.Text}" Text="Quạt GPU" />
                                                    <ItemsControl ItemsSource="{Binding GpuPoints}" Margin="0,10,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:FanPointViewModel}">
                                                                <StackPanel HorizontalAlignment="Center">
                                                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource Brush.Text}" Text="{Binding SpeedLabel}" />
                                                                    <Slider Height="130" Margin="0,6" Style="{StaticResource Slider.Fan}"
                                                                            Value="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                                                                    <TextBlock FontSize="10.5" HorizontalAlignment="Center"
                                                                               Foreground="{StaticResource Brush.TextDim}" Text="{Binding TemperatureLabel}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- POWER MODE -->
                                    <TextBlock Style="{StaticResource Text.SectionHeader}" Text="POWER MODE WINDOWS (tùy chọn)" />
                                    <ComboBox Width="280" HorizontalAlignment="Left" Style="{StaticResource Combo.Dark}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding PowerOverlay}">
                                        <ComboBoxItem Tag="{x:Static models:PowerOverlayMode.None}" Content="Không thay đổi" />
                                        <ComboBoxItem Tag="{x:Static models:PowerOverlayMode.BestPerformance}" Content="Best Performance" />
                                        <ComboBoxItem Tag="{x:Static models:PowerOverlayMode.Balanced}" Content="Balanced" />
                                        <ComboBoxItem Tag="{x:Static models:PowerOverlayMode.BestEfficiency}" Content="Best Power Efficiency" />
                                    </ComboBox>

                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <!-- ÁP DỤNG -->
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,10">
                        <Button Style="{StaticResource Button.Accent}" MinWidth="220"
                                Command="{Binding ApplyCommand}"
                                Content="✔  ÁP DỤNG SCENARIO" />
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                   TextWrapping="Wrap" MaxWidth="440"
                                   Text="{Binding ApplyBannerText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsApplySuccess}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
            </TabItem>

            <TabItem Header="📊  Hardware Monitoring">
                <views:MonitoringView />
            </TabItem>
        </TabControl>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Sidebar}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Brush.Warning}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHardwareReady}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource Brush.Success}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}"
                               Text="{Binding EcInfoText}"
                               ToolTip="{Binding StorePathText}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,18,0"
                               Text="{Binding Status.CpuText}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextDim}" Margin="0,0,18,0"
                               Text="{Binding Status.GpuText}" />
                    <TextBlock FontSize="12" Foreground="{StaticResource Brush.Text}"
                               Text="{Binding Status.ModeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
