    <sys:String x:Key="S.Label.FanAdvanced">Quạt tùy chỉnh</sys:String>
    <sys:String x:Key="S.Label.FanBoost">Cooler Boost</sys:String>
    <sys:String x:Key="S.Label.Idle">Nghỉ</sys:String>
